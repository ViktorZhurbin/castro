{
  "name": "@vktrz/castro",
  "version": "0.1.0",
  "description": "A static site generator built to be read.",
  "keywords": [
    "island-architecture",
    "islands",
    "preact",
    "ssg",
    "static-site-generator",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViktorZhurbin/castro.git"
  },
  "bin": {
    "castro": "./bin/castro"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "type": "module",
  "types": "./src/types.d.ts",
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "knip": "knip",
    "type-check": "tsc"
  },
  "dependencies": {
    "preact": "^10",
    "preact-render-to-string": "^6.5.12"
  },
  "devDependencies": {
    "knip": "^5.83.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
