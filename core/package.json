{
  "name": "@vktrz/castro",
  "version": "0.1.0",
  "description": "A simple static site generator with islands. Powered by Bun and Preact",
  "keywords": [
    "bun",
    "island-architecture",
    "preact",
    "ssg"
  ],
  "homepage": "https://castro.vktrz.workers.dev",
  "bugs": "https://github.com/ViktorZhurbin/castro/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViktorZhurbin/castro.git",
    "directory": "core"
  },
  "bin": {
    "castro": "bin/castro"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "type": "module",
  "types": "./src/types.d.ts",
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "default": "./src/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "knip": "knip",
    "type-check": "tsc"
  },
  "dependencies": {
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "knip": "^5.83.0",
    "preact": "^10.29.8",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "preact": "^10.29.8"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
