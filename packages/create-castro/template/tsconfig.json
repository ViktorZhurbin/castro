{
  "compilerOptions": {
    // Language and environment
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["@vktrz/castro"],

    // Module resolution
    "moduleResolution": "bundler",

    // Emit
    "noEmit": true,
    "isolatedModules": true,

    // Type checking
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Interop
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Path mappings (optional, for convenience)
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["types/**/*", "pages/**/*", "layouts/**/*", "components/**/*"]
}
